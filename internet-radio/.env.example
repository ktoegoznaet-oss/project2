# ========================
# Internet Radio — Environment
# ========================

# PostgreSQL
POSTGRES_DB=radio
POSTGRES_USER=radio_user
POSTGRES_PASSWORD=radio_secret_2024

# Redis
REDIS_URL=redis://redis:6379

# Backend
NODE_ENV=production
PORT=3000
JWT_SECRET=your-super-secret-jwt-key-change-me
JWT_EXPIRES_IN=7d

# OpenAI (для робота-ведущего и аналитики)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# ElevenLabs TTS (опционально, иначе используется edge-tts)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ЮKassa
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET=your-secret-key
YOOKASSA_WEBHOOK_URL=https://yourdomain.com/api/payments/webhook

# Icecast
ICECAST_HOST=icecast
ICECAST_PORT=8000
ICECAST_SOURCE_PASSWORD=source_hackme
ICECAST_ADMIN_PASSWORD=admin_hackme

# Liquidsoap
LIQUIDSOAP_TELNET_HOST=icecast
LIQUIDSOAP_TELNET_PORT=1234

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws
NEXT_PUBLIC_STREAM_URL=http://localhost:8000/stream

# Domain
DOMAIN=yourdomain.com
