# ========================
# Backend Environment
# ========================

# Server
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://radio_user:radio_secret_2024@postgres:5432/radio
DATABASE_READONLY_URL=postgres://radio_user:radio_secret_2024@postgres:5432/radio

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=change-this-to-a-very-long-random-string-at-least-64-chars
JWT_EXPIRES_IN=7d

# OpenAI — for DJ bot announcements and analytics agent
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ElevenLabs TTS (optional — falls back to edge-tts if empty)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# YooKassa payment gateway
YOOKASSA_SHOP_ID=your-yookassa-shop-id
YOOKASSA_SECRET=your-yookassa-secret-key
YOOKASSA_WEBHOOK_URL=https://yourdomain.com/api/payments/webhook
YOOKASSA_RETURN_URL=https://yourdomain.com/payment/success

# Icecast / Liquidsoap
ICECAST_HOST=icecast
ICECAST_PORT=8000
ICECAST_SOURCE_PASSWORD=source_hackme
LIQUIDSOAP_TELNET_HOST=icecast
LIQUIDSOAP_TELNET_PORT=1234

# Audio protection
HLS_SEGMENT_DIR=/app/hls
MUSIC_DIR=/app/music
JINGLES_DIR=/app/jingles

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3001
